# Local development settings, read by the Makefile's dev targets. Copy to
# deploy/.env.dev; never commit the copy. The identity service's values come
# from identity/dev/out/comments.env once its dev stack is up; see README.

COMMENTS_PUBLIC_URL=http://localhost:8081
COMMENTS_HTTP_ADDR=127.0.0.1:8081
# Lets the two test blogs on http://blog-a.localhost:8301 and
# http://blog-b.localhost:8302 embed the widget. Refused with an https
# COMMENTS_PUBLIC_URL.
COMMENTS_DEV_HTTP_ORIGINS=true
COMMENTS_ALLOW_PRIVATE_NETWORKS=true

COMMENTS_OIDC_ISSUER=http://localhost:8090
COMMENTS_OIDC_CLIENT_ID=
COMMENTS_OIDC_CLIENT_SECRET=
COMMENTS_IDP_WEBHOOK_SECRET=
COMMENTS_IDP_API_TOKEN=

# Development-only keys; generate your own with openssl rand -base64 32.
COMMENTS_DATA_KEYS=1:ZGV2LWRhdGEta2V5LWRldi1kYXRhLWtleS1kZXYtZGE=
COMMENTS_HMAC_KEY=ZGV2LWhtYWMta2V5LWRldi1obWFjLWtleS1kZXYtaG0=
COMMENTS_IP_KEY=ZGV2LWlwLWtleS1kZXYtaXAta2V5LWRldi1pcC1rZXk=

# Mailpit, run by the identity dev stack; mail stays queued while it is down.
COMMENTS_SMTP_URL=smtp://localhost:1025
COMMENTS_LOG_LEVEL=debug
