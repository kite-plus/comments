# Secrets and settings for deploy/docker-compose.yaml. Copy to .env next to
# it; never commit the copy. See docs/design/architecture.md section 8.

POSTGRES_PASSWORD=

COMMENTS_PUBLIC_URL=https://comments.kite.plus
COMMENTS_OIDC_ISSUER=https://id.kite.plus
COMMENTS_OIDC_CLIENT_ID=
COMMENTS_OIDC_CLIENT_SECRET=
# Signs the identity service's event deliveries to /hooks/idp.
COMMENTS_IDP_WEBHOOK_SECRET=
# A token for the identity service's event search API, for the hourly
# reconciliation; COMMENTS_IDP_API_URL defaults to the issuer.
COMMENTS_IDP_API_TOKEN=

# 32-byte keys, base64 (openssl rand -base64 32). Data keys are
# "version:key" pairs; the highest version encrypts, all decrypt. The HMAC
# key can never change.
COMMENTS_DATA_KEYS=1:
COMMENTS_HMAC_KEY=
COMMENTS_IP_KEY=

COMMENTS_SMTP_URL=smtps://user:password@smtp.example.com:465
COMMENTS_MAIL_FROM=Kite Plus 评论 <notify@kite.plus>
COMMENTS_LOG_LEVEL=info
