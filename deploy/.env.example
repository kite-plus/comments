# Secrets and settings for deploy/docker-compose.yaml. Copy to .env next to
# it; never commit the copy. See docs/design/architecture.md section 8.

# The image tag of ghcr.io/kite-plus/comments. No workflow publishes it
# yet; build it from the checkout on the server (README, Deployment).
COMMENTS_VERSION=latest

# Edge mode, how production runs: behind the Caddy shared with Explore on
# the kite-edge network (docker-compose.edge.yaml). Leave it commented out
# when a reverse proxy on this host reaches 127.0.0.1:8081 (deploy/Caddyfile).
# COMPOSE_FILE=docker-compose.yaml:docker-compose.edge.yaml
# Staging next to production on one server is a second checkout
# (/opt/comments-staging) whose .env also sets these three, so its project,
# Caddy upstream and network differ from production's.
# COMPOSE_PROJECT_NAME=comments-staging
# COMMENTS_EDGE_ALIAS=comments-staging
# COMMENTS_SUBNET=10.90.1.0/24

POSTGRES_PASSWORD=

COMMENTS_PUBLIC_URL=https://comments.kite.plus
COMMENTS_OIDC_ISSUER=https://id.kite.plus
COMMENTS_OIDC_CLIENT_ID=
COMMENTS_OIDC_CLIENT_SECRET=
# Signs the identity service's event deliveries to /hooks/idp. Needs
# COMMENTS_IDP_API_TOKEN: a delivery is acted on only once it is confirmed.
COMMENTS_IDP_WEBHOOK_SECRET=
# A read-only token for the identity service's user and event search APIs,
# for confirming deliveries and the hourly reconciliation;
# COMMENTS_IDP_API_URL defaults to the issuer.
COMMENTS_IDP_API_TOKEN=

# 32-byte keys, base64 (openssl rand -base64 32). Data keys are
# "version:key" pairs; the highest version encrypts, all decrypt. The HMAC
# key can never change.
COMMENTS_DATA_KEYS=1:
COMMENTS_HMAC_KEY=
COMMENTS_IP_KEY=

COMMENTS_SMTP_URL=smtps://user:password@smtp.example.com:465
COMMENTS_MAIL_FROM=Kite Plus 评论 <notify@kite.plus>
COMMENTS_LOG_LEVEL=info

# Backups (scripts/backup.sh): age public key the dumps are encrypted to,
# and where they go. BACKUP_REMOTE is an rclone remote:path off this server
# (another server over SFTP, or object storage); empty keeps them here only.
# Copies older than BACKUP_KEEP_DAYS (default 30) are pruned on both sides;
# BACKUP_REMOTE_KEEP_DAYS=0 leaves the remote side to the destination's own
# lifecycle rule, for credentials that may write but not delete.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/comments
BACKUP_REMOTE=
